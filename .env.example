# Пример переменных окружения для МТС EnergyTool ИИ-консультант
# Скопируйте в .env и заполните реальными значениями
# НИКОГДА не коммитьте реальные ключи в репозиторий!

# === ОБЯЗАТЕЛЬНЫЕ (предоставляются платформой / настраиваются локально) ===

# Базовый URL LLM API (OpenAI-совместимый endpoint)
# Локально (LM Studio): http://localhost:1234/v1
# На платформе: выдаётся организаторами
LLM_BASE_URL=

# API ключ для доступа к LLM
# Локально (LM Studio): lm-studio (или любой непустой)
# На платформе: выдаётся организаторами
LLM_API_KEY=

# Имя модели генерации
# На платформе: Qwen3.8-27B
# Локально: qwen3-8b (или другая загруженная в LM Studio)
LLM_MODEL=

# Модель эмбеддингов
# На платформе: BAAI/bge-m3
# Локально: text-embedding-nomic-embed-text-v2-moe (или другая в LM Studio)
EMB_MODEL=

# === АЛЬТЕРНАТИВНЫЕ ПЕРЕМЕННЫЕ (поддержка разных неймингов) ===
# Если LLM_BASE_URL не задан, будут проверены эти:
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEN_MODEL=

# === ПУТИ К ДАННЫМ ===
# Папка с questions.csv и knowledge-base.zip
# На платформе задаётся организаторами через DATA_DIR
# Локально: ./data
DATA_DIR=./data

# === ПАРАМЕТРЫ ГЕНЕРАЦИИ ===
TEMPERATURE=0.1
MAX_TOKENS=512
MAX_WORKERS=1

# === ПАРАМЕТРЫ RAG ===
TOP_K=10
CHUNKER_CHUNK_SIZE=512
CHUNKER_OVERLAP=100

# === РЕРАНКЕР (опционально) ===
RERANKER_MODEL=Qwen3-Reranker-8B
RERANKER_TOP_N=3
USE_RERANKER=true

# === ТАЙМАУТЫ И РЕТРАИ ===
REQUEST_TIMEOUT=180
MAX_RETRIES=3